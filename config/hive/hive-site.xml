<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- Keep the embedded Derby metastore inside the persisted Docker volume. -->
  <property>
    <name>javax.jdo.option.ConnectionURL</name>
    <value>jdbc:derby:/opt/hive/data/metastore_db;create=true</value>
  </property>

  <property>
    <name>javax.jdo.option.ConnectionDriverName</name>
    <value>org.apache.derby.jdbc.EmbeddedDriver</value>
  </property>

  <!-- The schema is created explicitly by schematool, then verified on startup. -->
  <property>
    <name>hive.metastore.schema.verification</name>
    <value>true</value>
  </property>
</configuration>
